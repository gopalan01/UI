# ==============================================================================
# THAMILI AUDIO GENERATOR - BACKEND CONFIGURATION
# Copy this file to .env and configure your desired AI providers.
# ==============================================================================

# Server Config
HOST=0.0.0.0
PORT=8000

# Provider Choices:
# STT_PROVIDER: groq | openai
# LLM_PROVIDER: groq | openai | gemini
# TTS_PROVIDER: edge-tts | openai
STT_PROVIDER=groq
LLM_PROVIDER=groq
TTS_PROVIDER=edge-tts

# ==============================================================================
# API KEYS (Leave empty to use built-in offline/Edge-TTS modes)
# ==============================================================================

# Groq Cloud API Key (Recommended - offers fast Whisper STT & Llama-3.3 LLM)
# Get your free key at: https://console.groq.com/keys
GROQ_API_KEY=

# OpenAI API Key (Optional - for Whisper STT, GPT-4o-mini LLM, and OpenAI TTS)
# Get key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Google Gemini API Key (Optional - for Gemini LLM)
# Get key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Generic aliases (optional)
STT_API_KEY=
LLM_API_KEY=
TTS_API_KEY=
